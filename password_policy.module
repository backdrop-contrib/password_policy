<?php

/**
 * @file
 * Enforces password policies.
 */

/**
 * Implements hook_config_info().
 */
function password_policy_config_info() {
  $prefixes['password_policy.policy'] = array(
    'name_key'  => 'name',
    'label_key' => 'label',
    'group'     => t('Password Policy'),
  );
  $prefixes['password_policy.settings'] = array(
    'label' => t('Password Policy settings'),
    'group' => t('Configuration'),
  );
  return $prefixes;
}

define('PASSWORD_POLICY_MENU_PATH', 'admin/config/people/password_policy');

/**
 * Implements hook_menu().
 */
function password_policy_menu() {
  $items = array();

  // List.
  $items[PASSWORD_POLICY_MENU_PATH] = array(
    'title' => 'Password policies',
    'description' => 'Manage password policies.',
    'page callback' => 'password_policy_configs_list',
    'access arguments' => array('administer password policy'),
    'type' => MENU_NORMAL_ITEM,
  );
  $items[PASSWORD_POLICY_MENU_PATH . '/list'] = array(
    'title' => 'List',
    'type'  => MENU_DEFAULT_LOCAL_TASK,
    'weight'=> -10,
  );
  // Add.
  $items[PASSWORD_POLICY_MENU_PATH . '/add'] = array(
    'title' => 'Add policy',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('password_policy_config_form'),
    'access arguments' => array('administer password policy'),
    'type' => MENU_LOCAL_ACTION,
  );
  // Edit.
  $items[PASSWORD_POLICY_MENU_PATH . '/manage/%password_policy_config'] = array(
    'title' => 'Edit policy',
    'title callback' => 'password_policy_config_edit_title',
    'title arguments' => array(5),
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('password_policy_config_form', 5),
    'access arguments' => array('administer password policy'),
  );
  // Disable/Enable.
  $items[PASSWORD_POLICY_MENU_PATH . '/manage/%password_policy_config/disable'] = array(
    'title' => 'Disable/Enable policy',
    'page callback' => 'password_policy_config_disable',
    'page arguments' => array(5),
    'access arguments' => array('administer password policy'),
  );
  // Clone.
  $items[PASSWORD_POLICY_MENU_PATH . '/manage/%password_policy_config/clone'] = array(
    'title' => 'Clone policy',
    'page callback' => 'password_policy_config_clone',
    'page arguments' => array(5),
    'access arguments' => array('administer password policy'),
  );
  // Delete.
  $items[PASSWORD_POLICY_MENU_PATH . '/manage/%password_policy_config/delete'] = array(
    'title' => 'Delete policy',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('password_policy_config_delete_confirm', 5),
    'access arguments' => array('administer password policy'),
  );

  // AJAX checker.
  $items['password_policy/check'] = array(
    'page callback'    => 'password_policy_ajax_check',
    'delivery callback'=> 'backdrop_json_deliver',
    'access callback'  => TRUE,
    'type'             => MENU_CALLBACK,
  );

  return $items;
}

/**
 * Menu arg loader: loads a policy config by machine name.
 */
function password_policy_config($name) {
  return password_policy_get_policy($name);
}

/**
 * Title callback for edit page.
 */
function password_policy_config_edit_title($config) {
  $label = !empty($config['label']) ? $config['label'] : $config['name'];
  return t('Edit @name policy', array('@name' => $label));
}

function password_policy_configs_list() {
  $policies = password_policy_get_policies();

  $header = array(t('Policy'), t('Status'), t('Operations'));
  $rows   = array();

  foreach ($policies as $name => $config) {
    $label = !empty($config['label']) ? $config['label'] : $name;
    $status = empty($config['disabled']) ? t('Enabled') : t('Disabled');

    $links = array(
      'configure' => array(
        'title' => t('Configure'),
        'href'  => PASSWORD_POLICY_MENU_PATH . '/manage/' . $name,
      ),
      'delete' => array(
        'title' => t('Delete'),
        'href'  => PASSWORD_POLICY_MENU_PATH . '/manage/' . $name . '/delete',
      ),
      'disable' => array(
        'title' => empty($config['disabled']) ? t('Disable') : t('Enable'),
        'href'  => PASSWORD_POLICY_MENU_PATH . '/manage/' . $name . '/disable',
      ),
      'clone' => array(
        'title' => t('Clone'),
        'href'  => PASSWORD_POLICY_MENU_PATH . '/manage/' . $name . '/clone',
      ),
    );
    $operations = array('#type' => 'operations', '#links' => $links);

    $rows[] = array(
      check_plain($label) . ' <small>(' . check_plain($name) . ')</small>',
      $status,
      array('data' => $operations),
    );
  }

  return array(
    '#theme'  => 'table',
    '#header' => $header,
    '#rows'   => $rows,
    '#empty'  => t('No password policies are available. <a href="@link">Add a policy</a>.', array('@link' => url(PASSWORD_POLICY_MENU_PATH . '/add'))),
  );
}

function password_policy_get_policies() {
  $configs = array();
  $names = config_get_names_with_prefix('password_policy.policy.');
  foreach ($names as $name) {
    $conf = config($name)->get();
    $id = str_replace('password_policy.policy.', '', $name);
    if ($conf) {
      $configs[$id] = $conf + array('name' => $id);
    }
  }
  return $configs;
}

function password_policy_get_policy($name) {
  return config_get('password_policy.policy.' . $name);
}

/**
 * Menu argument loader for %password_policy_config.
 * Converts the URL piece to an actual policy config array.
 */
function password_policy_config_load($name) {
  // If you ever use hyphens in URLs, convert back to underscores:
  $id = strtr($name, array('-' => '_'));

  $conf = password_policy_get_policy($id); // returns array or NULL
  return $conf ?: FALSE; // FALSE -> 404 if not found
}

function password_policy_save_policy(array $fields, array $original = array(), $messages = TRUE) {
  $cfg   = config('password_policy.policy.' . $fields['name']);
  $is_new = $cfg->isNew();
  $cfg->setMultiple($fields)->save();

  $saved = password_policy_get_policy($fields['name']);
  if (!$saved) {
    if ($messages) {
      backdrop_set_message(t('The policy %label could not be saved.', ['%label' => $fields['label']]), 'error');
    }
    return FALSE;
  }

  if ($messages) {
    $t = ['%label' => $fields['label']];
    backdrop_set_message($is_new ? t('The policy %label has been added.', $t)
      : t('The policy %label has been updated.', $t));
  }
  return $saved;
}

function password_policy_delete_policy($name, $messages = TRUE) {
  $cfg = config('password_policy.policy.' . $name);
  $label = ($c = $cfg->get()) && !empty($c['label']) ? $c['label'] : $name;

  $cfg->delete();
  $exists = password_policy_get_policy($name);
  if ($messages) {
    if ($exists) {
      backdrop_set_message(t('The policy %label was not deleted.', ['%label' => $label]), 'error');
    } else {
      backdrop_set_message(t('The policy %label has been deleted.', ['%label' => $label]));
    }
  }
  return !$exists;
}

function password_policy_config_form($form, &$form_state, $config = array()) {
  // Defaults for new policy.
  $config += array(
    'name'        => '',
    'label'       => '',
    'description' => '',
    'disabled'    => 0,
    'config'      => array(), // plugin configs live here
  );

  // Keep original for submit/delete comparisons.
  $form_state['storage']['original_policy'] = empty($config['name']) ? NULL : $config;

  // Build a policy object to render plugin settings.
  $policy = new PasswordPolicy((object) $config);

  // Basic info.
  $form['label'] = array(
    '#type' => 'textfield',
    '#title' => t('Policy name'),
    '#default_value' => $config['label'],
    '#required' => TRUE,
    '#size' => 40,
  );
  $form['name'] = array(
    '#type' => 'machine_name',
    '#default_value' => $config['name'],
    '#maxlength' => 64,
    '#disabled' => !empty($config['name']),
    '#machine_name' => array(
      'exists' => 'password_policy_config_exists',
      'source' => array('label'),
    ),
    '#description' => t('A unique machine name. Lowercase letters, numbers, and underscores only.'),
  );
  $form['description'] = array(
    '#type' => 'textfield',
    '#title' => t('Description'),
    '#default_value' => $config['description'],
  );
  $form['disabled'] = array(
    '#type' => 'checkbox',
    '#title' => t('Disabled'),
    '#default_value' => !empty($config['disabled']),
    '#description' => t('Disabled policies do not apply.'),
  );

  // Plugin-driven UI (conditions, constraints, items).
  // This merges in the vertical tabs and fieldsets your class returns.
  $form += $policy->adminForm($form, $form_state);

  $form['actions'] = array('#type' => 'actions');
  $form['actions']['submit'] = array(
    '#type' => 'submit',
    '#value' => t('Save policy'),
    '#submit' => array('password_policy_config_form_submit'),
  );
  if (!empty($config['name'])) {
    $form['actions']['delete'] = array(
      '#type' => 'submit',
      '#value' => t('Delete'),
      '#submit' => array('password_policy_config_form_delete_submit'),
      '#limit_validation_errors' => array(),
    );
  }

  // Stash the working object so submit can collect plugin config.
  $form_state['storage']['policy_object'] = $policy;

  return $form;
}

function password_policy_config_exists($name) {
  return (bool) password_policy_get_policy($name);
}

function password_policy_config_form_submit($form, &$form_state) {
  /** @var PasswordPolicy $policy */
  $policy = $form_state['storage']['policy_object'];

  // Let each plugin collect its config.
  $policy->adminFormSubmit($form, $form_state);

  $fields = array(
    'name'        => (string) $form_state['values']['name'],
    'label'       => (string) $form_state['values']['label'],
    'description' => (string) $form_state['values']['description'],
    'disabled'    => !empty($form_state['values']['disabled']) ? 1 : 0,
    'config'      => $policy->config,
  );

  $saved = password_policy_save_policy($fields, (array) $form_state['storage']['original_policy']);
  if ($saved) {
    $form_state['redirect'] = PASSWORD_POLICY_MENU_PATH;
  }
}

function password_policy_config_form_delete_submit($form, &$form_state) {
  $form_state['redirect'] = PASSWORD_POLICY_MENU_PATH . '/manage/' . $form['name']['#default_value'] . '/delete';
}

function password_policy_config_delete_confirm($form, &$form_state, $config) {
  $name  = $config['name'];
  $label = !empty($config['label']) ? $config['label'] : $name;

  $form['name']  = array('#type' => 'value', '#value' => $name);
  $form['label'] = array('#type' => 'value', '#value' => $label);

  $question = t('Are you sure you want to delete the policy %label?', array('%label' => $label));
  $caption  = '<p>' . t('This action cannot be undone.') . '</p>';
  return confirm_form($form, filter_xss_admin($question), PASSWORD_POLICY_MENU_PATH, filter_xss_admin($caption), t('Delete'));
}

function password_policy_config_delete_confirm_submit($form, &$form_state) {
  $name = $form_state['values']['name'];
  password_policy_delete_policy($name);
  $form_state['redirect'] = PASSWORD_POLICY_MENU_PATH;
}

/**
 * AJAX callback to check password against applicable policies.
 */
function password_policy_ajax_check() {
  // Accept both for easier debugging.
  $raw = isset($_REQUEST['password']) ? $_REQUEST['password'] : NULL;
  if ($raw === NULL) {
    return array('message' => '', 'strength' => 0, 'indicatorText' => '');
  }

  // Match the JS encodeURIComponent().
  $untrimmed_password = rawurldecode($raw);
  $password   = trim($untrimmed_password);
  $is_trimmed = ($password !== $untrimmed_password);

  if ($is_trimmed && $password === '') {
    return array(
      'message' => t('Password is all spaces and will not be saved.'),
      'strength' => 0,
      'indicatorText' => '',
    );
  }
  if (_password_policy_is_password_too_long($password)) {
    return array(
      'message' => t('Password exceeds maximum length. Please choose a shorter password.'),
      'strength' => 0,
      'indicatorText' => '',
    );
  }

  // Determine which account to evaluate policies for.
  $account = NULL;

  /*
   * Hardened behavior: only allow loading arbitrary accounts when the
   * requester has administrative privileges. Non-admin users may still
   * operate on their own account (so logged-in users can change their
   * own password), but cannot specify other users via request params.
   */
  global $user;
  $can_lookup_other = FALSE;
  if (!empty($user->uid) && function_exists('user_access')) {
    if (user_access('administer users') || user_access('administer password policy')) {
      $can_lookup_other = TRUE;
    }
  }

  // If uid provided: allow only for admins, or if it matches the requester.
  if (!empty($_REQUEST['uid']) && is_numeric($_REQUEST['uid']) && (int)$_REQUEST['uid'] > 0) {
    $req_uid = (int) $_REQUEST['uid'];
    if ($can_lookup_other) {
      if (function_exists('user_load')) {
        $account = user_load($req_uid);
      }
    }
    else {
      // Allow specification of own uid so logged-in users can check their
      // own password strength when the JS sends the uid explicitly.
      if (!empty($user->uid) && $req_uid === (int) $user->uid) {
        $account = $user;
      }
    }
  }

  // If name provided: allow only for admins, or if it matches the requester.
  if ($account === NULL && !empty($_REQUEST['name'])) {
    $req_name = rawurldecode($_REQUEST['name']);
    if ($can_lookup_other) {
      if (function_exists('user_load_by_name')) {
        $account = user_load_by_name($req_name);
      }
      else {
        // Fallback: query users table for a matching name.
        try {
          $record = db_select('users', 'u')
            ->fields('u', array('uid'))
            ->condition('name', $req_name)
            ->execute()
            ->fetchObject();
          if ($record) {
            if (function_exists('user_load')) {
              $account = user_load($record->uid);
            }
          }
        }
        catch (Exception $e) {
          watchdog('password_policy', 'Error looking up user by name in ajax check: @msg', array('@msg' => $e->getMessage()), WATCHDOG_WARNING);
        }
      }
    }
    else {
      // Allow using the name only if it matches the currently authenticated
      // user's username (prevents enumeration while allowing self-check).
      if (!empty($user->name) && $req_name === $user->name) {
        $account = $user;
      }
    }
  }

  // Final fallback: currently logged-in user (may be anonymous with uid 0).
  if ($account === NULL) {
    $account = $user;
  }

  password_policy_user_load(array($account->uid => $account));
  $policies = PasswordPolicy::matchedPolicies($account);

  if (!$policies) {
    return array('message' => '', 'strength' => 0, 'indicatorText' => '0 of 0');
  }

  $total = 0;
  $errors = array();
  foreach ($policies as $policy) {
    $total += count($policy->messages());
    $errors = array_merge($errors, $policy->check($password, $account));
  }

  $sus_count = max(0, $total - count($errors));
  $score = $total > 0 ? ($sus_count / $total) * 100 : 0;

  $msg = '';
  if (!empty($errors)) {
    $msg .= t('Password does not meet the following requirements:');
    $msg .= theme('item_list', array('items' => $errors));
    if ($is_trimmed) {
      $msg .= t('Password has spaces at the beginning or end which are ignored.');
    }
  }

  return array(
    'message' => $msg,
    'strength' => $score,
    'indicatorText' => t('@sus_count of @total', array('@sus_count' => $sus_count, '@total' => $total)),
  );
}

/**
 * Simple admin list page.
 */
function password_policy_admin_page() {
  $header = array(t('Name'), t('Status'));
  $rows = array();

  foreach (PasswordPolicy::allPolicies() as $name => $policy) {
    $rows[] = array(
      check_plain($policy->name),
      empty($policy->disabled) ? t('Enabled') : t('Disabled'),
    );
  }

  return array(
    '#type' => 'table',
    '#header' => $header,
    '#rows' => $rows,
    '#empty' => t('No password policies found.'),
  );
}

/**
 * Implements hook_plugin_manager_plugin_type().
 */
function password_policy_plugin_manager_plugin_type() {
  return array(
    'constraint' => array(
      'cache' => TRUE,
      'cache table' => 'cache',
      'defaults' => array(
        'class'  => 'PasswordPolicyConstraint',
        'module' => 'password_policy',
      ),
    ),
    'condition' => array(
      'cache' => TRUE,
      'cache table' => 'cache',
      'defaults' => array(
        'class'  => 'PasswordPolicyCondition',
        'module' => 'password_policy',
      ),
    ),
    'item' => array(
      'cache' => TRUE,
      'cache table' => 'cache',
      'defaults' => array(
        'class'  => 'PasswordPolicyItem',
        'module' => 'password_policy',
      ),
    ),
  );
}

/**
 * Implements hook_plugin_manager_directory().
 */
function password_policy_plugin_manager_directory($module, $type) {
  if ($module === 'password_policy') {
    return 'plugins/' . $type; // constraint → plugins/constraint, etc.
  }
}

/**
 * Implements hook_permission().
 */
function password_policy_permission() {
  return array(
    'administer password policy' => array(
      'title' => t('Administer password policy'),
    ),
  );
}

/**
 * Implements hook_cron().
 */
function password_policy_cron() {
  $policies = PasswordPolicy::enabledPolicies();
  foreach ($policies as $policy) {
    $policy->cron();
  }
}

/**
 * Implements hook_init().
 */
function password_policy_init() {
  global $user;
  $policies = PasswordPolicy::matchedPolicies($user);
  foreach ($policies as $policy) {
    $policy->init($user);
  }
}

/**
 * Alters the password element to show requirements and load JS.
 */
function password_policy_password_element_alter(array &$element, $account) {
  $items = array();
  $policies = PasswordPolicy::matchedPolicies($account);

  foreach ($policies as $policy) {
    $items = array_merge($items, $policy->messages());
  }

  if (count($items)) {
    $element['#description'] = (isset($element['#description']) ? $element['#description'] : '') .
      theme('item_list', array(
        'items' => $items,
        'title' => t('Passwords must meet the following requirements:'),
        'attributes' => array('id' => 'password-policy-requirements'),
      ));
  }

  $element['#attached']['js'][] = array(
    'data' => backdrop_get_path('module', 'password_policy') . '/password_policy.js',
    'weight' => 10,
  );

  $element['#attached']['library'][] = array('system', 'backdrop.form');

  $clean_url = config_get('system.core', 'clean_url');
  $settings = array('cleanUrl' => $clean_url);
  $element['#attached']['js'][] = array(
    'data' => array('passwordPolicy' => $settings),
    'type' => 'setting',
  );
}

/**
 * Implements hook_js_alter().
 */
function password_policy_js_alter(&$javascript) {
  // Set the strength title for password policy fields.
  $javascript['settings']['data'][] = array(
    'password' => array(
      'strengthTitle' => t('Password compliance:'),
    ),
  );
}

/**
 * Implements hook_form_alter().
 */
function password_policy_form_alter(&$form, &$form_state, $form_id) {
  // Do not show password requirements on the login form.
  if ($form_id === 'user_login') {
    return;
  }

  $user_obj = isset($form['#user']) ? $form['#user'] : $GLOBALS['user'];
  $attached = FALSE;

  // Case A: Top-level single password.
  if (!empty($form['pass']['#type']) && $form['pass']['#type'] === 'password') {
    $form['pass']['#attributes']['data-pp-check'] = '1';
    password_policy_password_element_alter($form['pass'], $user_obj);
    $attached = TRUE;
  }

  // Case B: Top-level confirm widget.
  if (!empty($form['pass']['#type']) && $form['pass']['#type'] === 'password_confirm') {
    $form['pass']['pass1']['#attributes']['data-pp-check'] = '1';
    password_policy_password_element_alter($form['pass'], $user_obj);
    $attached = TRUE;
  }

  // Case C: Under account[...] (edit forms can look like this).
  if (!empty($form['account']['pass']['#type']) && $form['account']['pass']['#type'] === 'password') {
    $form['account']['pass']['#attributes']['data-pp-check'] = '1';
    password_policy_password_element_alter($form['account']['pass'], $user_obj);
    $attached = TRUE;
  }
  if (!empty($form['account']['pass']['#type']) && $form['account']['pass']['#type'] === 'password_confirm') {
    $form['account']['pass']['pass1']['#attributes']['data-pp-check'] = '1';
    password_policy_password_element_alter($form['account']['pass'], $user_obj);
    $attached = TRUE;
  }

  if ($attached) {
    // Ensure our server-side validation still runs.
    $form['#validate'][] = 'password_policy_user_profile_form_validate';
  }
}

/**
 * Determines whether form has an account password element.
 */
function _password_policy_has_account_password_element($form) {
  return isset($form['account']['pass']['#type']) && $form['account']['pass']['#type'] == 'password_confirm';
}

/**
 * Validation for user_profile_form().
 */
function password_policy_user_profile_form_validate($form, &$form_state) {
  if (!isset($form_state['values']['pass'])) {
    return;
  }

  $val = $form_state['values']['pass'];
  // Extract the actual string for either single or confirm widget.
  $pass = is_array($val) ? (isset($val['pass1']) ? $val['pass1'] : '') : (string) $val;

  if ($pass === '') {
    return;
  }

  if (_password_policy_is_password_too_long($pass)) {
    form_set_error('pass', t('Password exceeds maximum length. Please choose a shorter password.'));
    return;
  }

  $account = isset($form['#user']) ? $form['#user'] : $GLOBALS['user'];
  $errors = array();
  foreach (PasswordPolicy::matchedPolicies($account) as $policy) {
    $errors = array_merge($errors, $policy->check($pass, $account));
  }
  if (!empty($errors)) {
    form_set_error('pass', theme('item_list', array('items' => $errors)));
  }
}

/**
 * Max password length guard (mirrors core limit).
 */
function _password_policy_is_password_too_long($password) {
  return strlen($password) > 512;
}

/**
 * Store one password hash event in history.
 *
 * $pass here is expected to be the same hashed value as users.pass.
 */
function _password_policy_store_password($uid, $pass, $is_generated = FALSE) {
  $history = (object) array(
    'uid' => $uid,
    'pass' => $pass,
    'created' => REQUEST_TIME,
    'is_generated' => $is_generated ? 1 : 0,
    'data' => array(),
  );
  password_policy_update_password_history($history);
}

/**
 * Implements hook_user_insert().
 *
 * Store the initial password hash in history.
 */
function password_policy_user_insert($account) {
  if (!empty($account->pass) && !empty($account->uid)) {
    // At this point Backdrop has already hashed $account->pass.
    $is_password_generated = config_get('system.core', 'user_email_verification');
    _password_policy_store_password($account->uid, $account->pass, $is_password_generated);
  }
}

/**
 * Implements hook_user_update().
 *
 * Store new password hashes in history when the password actually changes.
 */
function password_policy_user_update($account) {
  if (empty($account->uid)) {
    return;
  }

  // If there is an original account and the hash changed, record it.
  if (!empty($account->original) && isset($account->original->pass) && isset($account->pass) && $account->pass !== $account->original->pass) {
    _password_policy_store_password($account->uid, $account->pass);
  }
}

/**
 * Implements hook_user_load().
 *
 * Adds password history to user (used by constraints like past_passwords/expire).
 */
function password_policy_user_load($accounts) {
  foreach ($accounts as $account) {
    $account->password_history = array();
  }

  $query = db_select('password_policy_history', 'p')
    ->condition('p.uid', array_keys($accounts))
    ->fields('p', array('uid', 'pass', 'created', 'is_generated'))
    ->orderBy('hid', 'DESC');

  $result = $query->execute();
  foreach ($result as $record) {
    $accounts[$record->uid]->password_history[] = $record;
  }
}

/**
 * Insert a history record.
 */
function password_policy_update_password_history($history) {
  db_insert('password_policy_history')
    ->fields(array(
      'uid' => $history->uid,
      'created' => $history->created,
      'pass' => $history->pass,
      'is_generated' => $history->is_generated ? 1 : 0,
    ))
    ->execute();
}

/**
 * Implements hook_token_info().
 */
function password_policy_token_info() {
  $type = array(
    'name' => t('Password Expiration Date'),
    'description' => t('Tokens related to expired passwords.'),
    'needs-data' => 'password_expiration_date',
  );
  $formats = module_invoke_all('date_format_types');

  foreach ($formats as $name => $title) {
    $format[$name] = array(
      'name' => t('Expire Date @title Format', array('@title' => $title)),
      'description' => t('The Date the Password Expires in the @title Format.', array('@title' => $title)),
    );
  }
  $format['interval'] = array(
    'name' => t('Expire Date interval'),
    'description' => t('The Date the Password Expires in x days format'),
  );

  return array(
    'types' => array('password_expiration_date' => $type),
    'tokens' => array('password_expiration_date' => $format),
  );
}

/**
 * Implements hook_tokens().
 */
function password_policy_tokens($type, $tokens, $data, $options) {
  if ($type == 'password_expiration_date') {
    $replacements = array();
    foreach ($tokens as $key => $token) {
      if ($key == 'interval') {
        $replacements[$token] = format_interval($data['password_expiration_date'] - REQUEST_TIME);
      }
      else {
        $replacements[$token] = format_date($data['password_expiration_date'], $key);
      }
    }
    return $replacements;
  }
}

/**
 * Implements hook_mail().
 */
function password_policy_mail($key, &$message, $params) {
  $message['subject'] .= $params['subject'];
  $message['body'][] = $params['body'];
}

/**
 * Parse relative interval text (e.g., "2 weeks") to seconds.
 */
function password_policy_parse_interval($string, $report_errors = FALSE) {
  $int = strtotime($string, 0);
  if ($report_errors && $int === FALSE) {
    backdrop_set_message(t("Unable to parse time interval. Please use something like '1 day' or '2 weeks'."), 'error');
  }
  return $int;
}

/**
 * Implements hook_default_password_policy_alter().
 */
function password_policy_default_password_policy_alter(&$policies) {
  // Only display this policy if no other policies are defined.
  if (count($policies) > 0) {
    return;
  }

  $config = array(
    'alpha_count' => array('alpha_count' => '1'),
    'char_count'  => array('char_count'  => '8'),
    'int_count'   => array('int_count'   => '1'),
    'past_passwords' => array('past_passwords' => '3'),
    'special_count'  => array(
      'special_count'       => 1,
      'special_count_chars' => '`~!@#$%^&*()_+=-|}{"?:><,./;\'\\[]',
    ),
  );

  $password_policy = new stdClass();
  $password_policy->disabled    = TRUE;
  $password_policy->api_version = 1;
  $password_policy->name        = 'Example policy';
  // Backdrop config should be an ARRAY, not serialized.
  $password_policy->config      = $config;

  $policies['Example policy'] = $password_policy;
}

/**
 * Implements hook_password_policy_expire_url_exclude().
 */
function password_policy_password_policy_expire_url_exclude($account) {
  if ((arg(0) == 'system' || arg(0) == 'file') && arg(1) == 'ajax') {
    return FALSE;
  }
  if (arg(0) == 'user' && arg(1) == 'logout') {
    return FALSE;
  }
  if (arg(0) == 'user' && arg(1) == 'reset' && is_string(arg(2))) {
    return FALSE;
  }
  if (module_exists('logintoboggan')) {
    if (arg(0) == 'user' && arg(1) == 'validate' && is_string(arg(2))) {
      return FALSE;
    }
  }
  if (module_exists('urllogin')) {
    if (arg(0) == 'l' && is_string(arg(1))) {
      return FALSE;
    }
  }
}

/**
 * Implements hook_user_delete().
 */
function password_policy_user_delete($account) {
  db_delete('password_policy_history')
    ->condition('uid', $account->uid)
    ->execute();
}

/**
 * Implements hook_help().
 */
function password_policy_help($path, $arg) {
  switch ($path) {
    case 'admin/help#password_policy':
      return _password_policy_get_help_output();
  }
}

/**
 * Load README.txt for hook_help().
 */
function _password_policy_get_help_output() {
  $readme = _password_policy_get_readme();
  return $readme === FALSE ? '' : ('<pre>' . $readme . '</pre>');
}

/**
 * Gets README.txt.
 */
function _password_policy_get_readme() {
  $filepath = dirname(__FILE__) . '/README.txt';
  return file_exists($filepath) ? file_get_contents($filepath) : FALSE;
}

/**
 * Implements hook_autoload_info().
 */
function password_policy_autoload_info() {
  return array(
    'PasswordPolicy'           => 'includes/PasswordPolicy.inc',
    'PasswordPolicyCondition'  => 'includes/PasswordPolicyCondition.inc',
    'PasswordPolicyConstraint' => 'includes/PasswordPolicyConstraint.inc',
    'PasswordPolicyItem'       => 'includes/PasswordPolicyItem.inc',
    'PasswordPolicyExpire'     => 'plugins/item/expire.inc',
  );
}

/**
 * Preferred order for password_policy plugins (lower = earlier).
 */
function _password_policy_weight_map() {
  return array(
    // Constraints (left column order)
    'backdrop_strength'  => -110,
    'username'           => -100,
    'special_count'      =>  -90,
    'alpha_count'        =>  -80,
    'alpha_case'         =>  -70,
    'char_count'         =>  -60,
    'blacklist'          =>  -50,
    'consecutive'        =>  -40,
    'past_passwords'     =>  -30,
    'int_count'          =>  -20,
    'delay'              =>  -10,

    // Conditions
    'role'               =>   10,
    'authmap'            =>   20,

    // Other items
    'expire'             =>   30,
  );
}

/**
 * Menu callback to disable or enable a password policy.
 */
function password_policy_config_disable($config) {
  // Toggle the disabled state.
  $cfg = config('password_policy.policy.' . $config['name']);
  $new_state = empty($config['disabled']) ? 1 : 0;
  $cfg->set('disabled', $new_state)->save();

  $action = $new_state ? t('disabled') : t('enabled');
  backdrop_set_message(t('The policy %label has been %action.', [
    '%label' => $config['label'],
    '%action' => $action,
  ]));

  backdrop_goto(PASSWORD_POLICY_MENU_PATH);
}

/**
 * Menu callback to clone a password policy.
 */
function password_policy_config_clone($config) {
  // Generate a new machine name for the clone.
  $original_name = $config['name'];
  $new_name = $original_name . '_clone';
  $new_label = !empty($config['label']) ? $config['label'] . ' (Clone)' : $new_name;

  // Ensure the new name is unique.
  $counter = 1;
  while (password_policy_get_policy($new_name)) {
    $new_name = $original_name . '_clone' . $counter;
    $new_label = !empty($config['label']) ? $config['label'] . " (Clone $counter)" : $new_name;
    $counter++;
  }

  // Prepare the fields for the new policy.
  $fields = $config;
  $fields['name'] = $new_name;
  $fields['label'] = $new_label;
  $fields['disabled'] = 1; // Cloned policies start disabled.

  // Remove any keys that shouldn't be copied.
  unset($fields['api_version']);

  // Save the new policy.
  password_policy_save_policy($fields);

  backdrop_set_message(t('The policy %label has been cloned as %new_label.', [
    '%label' => $config['label'],
    '%new_label' => $new_label,
  ]));

  backdrop_goto(PASSWORD_POLICY_MENU_PATH);
}
